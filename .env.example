# ---------------------------------------------------------------------------
# CodeGate Guardian — self-hosted configuration
#
# Guardian receives reports from the codegate agent running on developer
# machines and shows what it is told. It never sends anything to a machine.
#
# For the bundled Docker stack you need AUTH_SECRET, SETUP_TOKEN and
# AGENT_INGEST_TOKEN;
# docker/docker-compose.yml supplies everything else. Copy this file to
# .env.local for a local `pnpm dev`, or to .env for `docker compose`.
#
# It talks to nothing but its own Postgres. There is no analytics, no error
# reporting, no hosted database and no telemetry: Next.js's own reporting is
# switched off in the dev/build/start scripts and in every Docker stage.
# ---------------------------------------------------------------------------

# Session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=****

# Absolute URL this instance is served from.
#
# Set this on any real deployment. It is not cosmetic: it is the address
# handed back to a machine when it enrols, and the one that machine reports to
# from then on. Left at the default, every agent that enrols is told to report
# to its own localhost, and nothing ever arrives.
APP_URL=http://localhost:3000

# Claims this instance. Registration on a fresh install has to let somebody
# in to become the first operator, and until they do, reaching the port is the
# whole of authentication. This token means that window belongs to whoever
# deployed it. Leave it unset and an unclaimed console cannot be claimed at
# all — which is the safe way to be wrong.
# Generate one with: openssl rand -hex 32
SETUP_TOKEN=

# --- Fleet ingest ---------------------------------------------------------
# Shared bearer token every codegate agent presents when reporting. Leave unset
# and enrolment is closed: no NEW machine can join, and the console says so on
# its overview. Machines already enrolled keep reporting with their own
# per-machine tokens — which is what makes rotating this safe.
# Generate one with: openssl rand -hex 32
AGENT_INGEST_TOKEN=

# --- Database -------------------------------------------------------------
# Any standard-wire-protocol Postgres.
# Bundled compose stack: postgresql://postgres:postgres@postgres:5432/postgres
# The bundled stack, reached from the host: the compose file publishes it on
# 15432 rather than 5432, so it does not collide with another project's.
POSTGRES_URL=postgresql://postgres:postgres@localhost:15432/postgres

# --- Serving under a path -------------------------------------------------
# Set both together to serve the console from a sub-path behind a reverse
# proxy. NEXT_PUBLIC_BASE_PATH is baked in at build time, so changing it
# needs a rebuild, not just a restart.
# NEXT_PUBLIC_BASE_PATH=/guardian
# IS_DEMO=false

# Host ports the compose stack publishes on. Change either if something else
# on this machine already has the port — another project's Postgres is the
# usual one.
# APP_PORT=3000
# POSTGRES_PORT=15432

# Which interface the console is published on. Loopback by default, so a
# fresh instance is not reachable from the network before anyone has claimed
# it. Agents on other machines cannot reach it until you widen this:
#
#   APP_BIND=0.0.0.0
#
# Do that after you have registered, and put a TLS-terminating reverse proxy
# in front rather than exposing the container directly — session cookies and
# agent tokens both cross the wire.
# APP_BIND=127.0.0.1

# Password for the bundled Postgres. The default is fine while the database
# is loopback-only and only the app shares its network, which is how the
# compose stack ships. Set one if you publish the database, run it somewhere
# shared, or simply would rather the fleet inventory not sit behind
# postgres/postgres.
# POSTGRES_PASSWORD=postgres

# Optional. The address of the site that describes this product, which is a
# separate deployment (codegate-guardian-site). When set, the sign-in screen
# shows a "Back" link pointing at it. Unset, no such link is rendered — a link
# that returns you to the page you are already on is worse than no link.
#   NEXT_PUBLIC_SITE_URL=https://guardian.codegate.example
NEXT_PUBLIC_SITE_URL=
