# ---------------------------------------------------------------------------
# CodeGate Guardian — self-hosted configuration
#
# Guardian receives reports from the codegate agent running on developer
# machines and shows what it is told. It never sends anything to a machine.
#
# For the bundled Docker stack you only need AUTH_SECRET and AGENT_INGEST_TOKEN;
# docker/docker-compose.yml supplies everything else. Copy this file to
# .env.local for a local `pnpm dev`, or to .env for `docker compose`.
# ---------------------------------------------------------------------------

# Session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=****

# Absolute URL this instance is served from. Used for page metadata and for
# building fetchable URLs for locally stored uploads.
APP_URL=http://localhost:3000

# Claims this instance. Registration on a fresh install has to let somebody
# in to become the first operator, and until they do, reaching the port is the
# whole of authentication. This token means that window belongs to whoever
# deployed it. Leave it unset and an unclaimed console cannot be claimed at
# all — which is the safe way to be wrong.
# Generate one with: openssl rand -hex 32
SETUP_TOKEN=

# --- Fleet ingest ---------------------------------------------------------
# Shared bearer token every codegate agent presents when reporting. Leave unset
# and the ingest endpoint is closed: no machine can report in, and the console
# says so on its overview.
# Generate one with: openssl rand -hex 32
AGENT_INGEST_TOKEN=

# --- Database -------------------------------------------------------------
# Any standard-wire-protocol Postgres.
# Bundled compose stack: postgresql://postgres:postgres@postgres:5432/postgres
# Local Postgres on the host: postgresql://postgres:postgres@localhost:5432/postgres
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Redis (optional) -----------------------------------------------------
# The app runs without it.
REDIS_URL=redis://localhost:6379

# --- Uploads --------------------------------------------------------------
# filesystem (default): objects are written under OBJECT_STORE_PATH and served
# by the app itself at /api/uploads. Mount that path as a volume to persist it.
# s3: any S3-compatible endpoint, including the MinIO service in the compose
# stack.
OBJECT_STORE_DRIVER=filesystem
OBJECT_STORE_PATH=./data/uploads

# Required when OBJECT_STORE_DRIVER=s3.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=codegate-guardian-uploads
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_URL_BASE=http://localhost:9000/codegate-guardian-uploads
# S3_FORCE_PATH_STYLE=true

# --- Telemetry (optional) -------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
