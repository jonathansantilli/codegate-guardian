# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# optional direct Gemini key (used when selecting google/* models)
# preferred name for @ai-sdk/google
GOOGLE_GENERATIVE_AI_API_KEY=****

# alias supported in this project for convenience
GEMINI_API_KEY=****

# optional demo flag: when true, reporting endpoint returns global data across all users/sessions
# useful for hackathons where local/prod run as different guest users
HACKATHON_MODE=false

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Postgres connection string. Any standard-wire-protocol Postgres works.
#
# Local Docker (see docker-compose.yml):
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
#
# Supabase (Dashboard → Project Settings → Database → Connection string →
# "Transaction pooler", port 6543, serverless-safe):
# POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
#
# Vercel Postgres / Neon / RDS: paste the URL they give you.
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****
