# ---------------------------------------------------------------------------
# CodeGate Guardian — self-hosted configuration
#
# For the bundled Docker stack you only need to set AUTH_SECRET and a Gemini
# key; docker/docker-compose.yml supplies everything else. Copy this file to
# .env.local for a local `pnpm dev`, or to .env for `docker compose`.
# ---------------------------------------------------------------------------

# Session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=****

# Absolute URL this instance is served from. Used for page metadata and for
# building fetchable URLs for locally stored uploads.
APP_URL=http://localhost:3000

# --- Model provider -------------------------------------------------------
# Gemini is the only hosted provider; models are called directly, no gateway.
# Either name works; GOOGLE_GENERATIVE_AI_API_KEY is the one @ai-sdk/google
# reads natively.
GOOGLE_GENERATIVE_AI_API_KEY=****
# GEMINI_API_KEY=****

# --- Database -------------------------------------------------------------
# Any standard-wire-protocol Postgres.
# Bundled compose stack: postgresql://postgres:postgres@postgres:5432/postgres
# Local Postgres on the host: postgresql://postgres:postgres@localhost:5432/postgres
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Redis (optional) -----------------------------------------------------
# Enables resumable streams and IP rate limiting. The app runs without it.
REDIS_URL=redis://localhost:6379

# --- Uploads --------------------------------------------------------------
# filesystem (default): objects are written under OBJECT_STORE_PATH and served
# by the app itself at /api/uploads. Mount that path as a volume to persist it.
# s3: any S3-compatible endpoint, including the MinIO service in the compose
# stack.
OBJECT_STORE_DRIVER=filesystem
OBJECT_STORE_PATH=./data/uploads

# Required when OBJECT_STORE_DRIVER=s3.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=codegate-guardian-uploads
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_URL_BASE=http://localhost:9000/codegate-guardian-uploads
# S3_FORCE_PATH_STYLE=true

# --- Optional features ----------------------------------------------------
# Reporting endpoints return data across all users/sessions. Useful for demos
# where local and deployed instances run as different guest users.
HACKATHON_MODE=false

# Expose locally installed CLI agents (claude-code/*, codex/*) as models.
ENABLE_LOCAL_CLI_MODELS=false
# LOCAL_CLI_MODELS=claude-code/sonnet,codex/gpt-5
# CODEX_BIN=/usr/local/bin/codex

# Overrides where the codegate CLI keeps its rules cache. Set inside the
# container because the app user's home directory is read-only.
# CODEGATE_HOME=/tmp/.codegate

# --- Telemetry (optional) -------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
