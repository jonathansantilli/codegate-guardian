{
  "name": "codegate-guardian",
  "version": "3.1.0",
  "description": "Self-hosted console that shows what the codegate agent reports from developer machines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathansantilli/codegate-guardian.git"
  },
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbo",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "tsx --test 'tests/unit/**/*.test.ts'",
    "test:unit:watch": "tsx --test --watch 'tests/unit/**/*.test.ts'",
    "test:unit:coverage": "c8 --reporter=text --reporter=lcov --include='src/domain/**/*.ts' --include='src/application/**/*.ts' pnpm test:unit",
    "test:integration": "tsx --test 'tests/integration/**/*.test.ts'",
    "test:e2e": "export PLAYWRIGHT=True && pnpm exec playwright test",
    "fresh": "node scripts/fresh-install.mjs"
  },
  "dependencies": {
    "bcrypt-ts": "^9.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.34.0",
    "lucide-react": "^1.32.0",
    "next": "16.2.0",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.3.0",
    "postgres": "^3.4.4",
    "radix-ui": "^1.4.3",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "c8": "^12.0.0",
    "drizzle-kit": "^0.25.0",
    "postcss": "^8",
    "tailwindcss": "^4.1.13",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "ultracite": "^7.0.11"
  },
  "packageManager": "pnpm@10.32.1"
}
